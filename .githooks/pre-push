#!/bin/bash
# Refuses a push to master: changes reach master through a PR (see CONTRIBUTING.md).
# Enable once per clone:  git config core.hooksPath .githooks
# Bootstrap override:     ALLOW_MASTER_PUSH=1 git push
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "refs/heads/master" ] && [ "${ALLOW_MASTER_PUSH:-0}" != "1" ]; then
		echo "Push to master refused. Push a <name>/<type>/<topic> branch and open a PR." >&2
		exit 1
	fi
done
