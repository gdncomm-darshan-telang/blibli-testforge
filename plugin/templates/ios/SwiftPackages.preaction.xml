
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Downloading Local Swift Packages"
               scriptText = "cd &quot;$SRCROOT&quot;&#10;sh SwiftPackages.sh download&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "{APP_UUID}"
                     BuildableName = "{APP_BUILDABLE}"
                     BlueprintName = "{APP_NAME}"
                     ReferencedContainer = "container:{CONTAINER}">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
