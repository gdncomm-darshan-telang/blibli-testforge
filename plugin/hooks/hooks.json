{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|mcp__.*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/testforge-guard.mjs\"", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/testforge-session.mjs\"", "timeout": 10 }] }
    ]
  }
}
